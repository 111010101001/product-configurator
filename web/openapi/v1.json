  "components": {
    "schemas": {
      "OptionGroupResponse": {
        "required": [
          "id",
          "name",
          "mode",
          "options"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/SelectionMode"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionResponse"
            }
          }
        }
      },
      "OptionResponse": {
        "required": [
          "id",
          "code",
          "name",
          "priceDelta"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceDelta": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductDetailsResponse": {
        "required": [
          "id",
          "name",
          "sku",
          "basePrice",
          "optionGroups",
          "rules"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "basePrice": {
            "type": "number",
            "format": "double"
          },
          "optionGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionGroupResponse"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleResponse"
            }
          }
        }
      },
      "ProductRequest": {
        "required": [
          "name",
          "sku",
          "basePrice"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "sku": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[A-Z0-9-]+$",
            "type": "string"
          },
          "basePrice": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        }
      },
      "ProductSummaryResponse": {
        "required": [
          "id",
          "name",
          "sku",
          "basePrice"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "basePrice": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RuleResponse": {
        "required": [
          "id",
          "type",
          "sourceOptionId",
          "targetOptionId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "$ref": "#/components/schemas/RuleType"
          },
          "sourceOptionId": {
            "type": "integer",
            "format": "int32"
          },
          "targetOptionId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RuleType": {
        "enum": [
          "Requires",
          "Excludes"
        ]
      },
      "SaveConfigurationRequest": {
        "required": [
          "name",
          "optionIds"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "optionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "SavedConfigurationResponse": {
        "required": [
          "id",
          "productId",
          "name",
          "created",
          "selectedOptions",
          "totalPrice"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "selectedOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelectedOptionResponse"
            }
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SelectedOptionResponse": {
        "required": [
          "optionId",
          "code",
          "name",
          "groupName",
          "priceDelta"
        ],
        "type": "object",
        "properties": {
          "optionId": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "priceDelta": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SelectionMode": {
        "enum": [
          "ExactlyOne",
          "AtMostOne",
          "AnyNumber"
        ]
      },
      "ValidateConfigurationRequest": {
        "required": [
          "optionIds"
        ],
        "type": "object",
        "properties": {
          "optionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ValidationResultResponse": {
        "required": [
          "isValid",
          "totalPrice",
          "violations"
        ],
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ViolationResponse"
            }
          }
        }
      },
      "ViolationResponse": {
        "required": [
          "code",
          "message",
          "optionIds"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "optionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Configurations"
    },
    {
      "name": "Products"
